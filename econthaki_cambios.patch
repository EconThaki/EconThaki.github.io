new file mode 100644
index 0000000..87ca87f
--- /dev/null
+++ b/en/index.html
@@ -0,0 +1,597 @@
+---
+layout: default
+title: Home
+permalink: /en/
+lang: en
+alt_url: /
+---
+ 
+<style>
+ 
+/* ================================
+   HERO
+================================ */
+.hero-section {
+  position: relative;
+  min-height: 560px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  overflow: hidden;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.hero-bg {
+  position: absolute;
+  inset: 0;
+  background-image: url('{{ site.baseurl }}/assets/images/Encuentro_presencial/grupal_1.JPG');
+  background-size: cover;
+  background-position: center;
+  filter: brightness(0.35);
+}
+.hero-content {
+  position: relative;
+  z-index: 2;
+  padding: 60px 24px;
+  max-width: 800px;
+}
+.hero-content h1 {
+  font-size: 2.7rem;
+  font-weight: 800;
+  color: white;
+  line-height: 1.25;
+  margin-bottom: 20px;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.hero-content p {
+  font-size: 1.15rem;
+  color: rgba(255,255,255,0.88);
+  line-height: 1.8;
+  margin-bottom: 12px;
+}
+.hero-content p.hero-subtag {
+  font-size: 0.92rem;
+  color: rgba(255,255,255,0.55);
+  margin-bottom: 36px;
+  font-style: italic;
+}
+.hero-buttons {
+  display: flex;
+  gap: 16px;
+  justify-content: center;
+  flex-wrap: wrap;
+}
+.btn-hero-primary {
+  background: #00CDC8;
+  color: #0F0F0F;
+  padding: 13px 30px;
+  border-radius: 6px;
+  text-decoration: none;
+  font-weight: 700;
+  font-size: 1rem;
+  transition: opacity 0.2s;
+}
+.btn-hero-primary:hover { opacity: 0.85; text-decoration: none; color: #0F0F0F; }
+.btn-hero-secondary {
+  background: transparent;
+  color: white;
+  padding: 13px 30px;
+  border-radius: 6px;
+  border: 2px solid white;
+  text-decoration: none;
+  font-weight: 700;
+  font-size: 1rem;
+  transition: opacity 0.2s;
+}
+.btn-hero-secondary:hover { opacity: 0.85; text-decoration: none; color: white; }
+ 
+/* ================================
+   STATS
+================================ */
+.stats-section {
+  background: #0F0F0F;
+  padding: 48px 24px;
+  text-align: center;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.stats-grid {
+  display: flex;
+  justify-content: center;
+  gap: 56px;
+  flex-wrap: wrap;
+  max-width: 900px;
+  margin: 0 auto;
+}
+.stat-item h2 {
+  font-size: 3rem;
+  font-weight: 800;
+  color: #00CDC8;
+  margin: 0;
+  line-height: 1;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.stat-item p {
+  font-size: 0.9rem;
+  color: rgba(255,255,255,0.65);
+  margin: 6px 0 0 0;
+  line-height: 1.4;
+}
+ 
+/* ================================
+   MISIÓN CON FOTO
+================================ */
+.mision-section {
+  padding: 72px 24px;
+  max-width: 1000px;
+  margin: 0 auto;
+}
+.mision-inner {
+  display: flex;
+  gap: 56px;
+  align-items: center;
+  flex-wrap: wrap;
+}
+.mision-texto {
+  flex: 1;
+  min-width: 280px;
+}
+.mision-texto h2 {
+  font-size: 1.8rem;
+  color: #0F0F0F;
+  margin-bottom: 16px;
+  font-weight: 700;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.mision-texto p {
+  font-size: 1.02rem;
+  color: #555;
+  line-height: 1.85;
+  margin-bottom: 24px;
+}
+.mision-keywords {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+.mision-keyword {
+  padding: 5px 14px;
+  border-radius: 999px;
+  font-size: 0.82rem;
+  font-weight: 600;
+  letter-spacing: 0.5px;
+  border: 1.5px solid;
+}
+.mision-keyword.k-turquesa { border-color: #00CDC8; color: #00CDC8; }
+.mision-keyword.k-coral { border-color: #FF4A60; color: #FF4A60; }
+.mision-keyword.k-morado { border-color: #9F4AFF; color: #9F4AFF; }
+.mision-keyword.k-negro { border-color: #0F0F0F; color: #0F0F0F; }
+.mision-foto {
+  flex: 1;
+  min-width: 280px;
+}
+.mision-foto img {
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: 10px;
+  box-shadow: 0 8px 30px rgba(0,0,0,0.12);
+}
+ 
+/* ================================
+   FASES
+================================ */
+.fases-section {
+  background: #f7f7f7;
+  padding: 72px 24px;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.fases-section h2 {
+  text-align: center;
+  font-size: 1.8rem;
+  color: #0F0F0F;
+  margin-bottom: 8px;
+  font-weight: 700;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.fases-subtitulo {
+  text-align: center;
+  color: #888;
+  margin-bottom: 48px;
+  font-size: 1rem;
+}
+.fases-grid {
+  display: flex;
+  gap: 24px;
+  max-width: 1000px;
+  margin: 0 auto;
+  flex-wrap: wrap;
+  align-items: flex-start;
+}
+.fase-card {
+  flex: 1;
+  min-width: 240px;
+  background: white;
+  border-radius: 10px;
+  padding: 36px 28px;
+  text-align: center;
+  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
+}
+.fase-numero {
+  width: 52px;
+  height: 52px;
+  background: #00CDC8;
+  color: #0F0F0F;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.4rem;
+  font-weight: 800;
+  margin: 0 auto 16px auto;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.fase-card h3 {
+  font-size: 1.2rem;
+  color: #0F0F0F;
+  margin: 0 0 12px 0;
+  font-weight: 700;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.fase-card p {
+  font-size: 0.92rem;
+  color: #666;
+  line-height: 1.7;
+  margin: 0 0 16px 0;
+}
+.fase-card a {
+  color: #00CDC8;
+  font-weight: 600;
+  font-size: 0.9rem;
+  text-decoration: none;
+}
+.fase-card a:hover { text-decoration: underline; }
+.fase-flecha {
+  font-size: 2rem;
+  color: #00CDC8;
+  align-self: center;
+}
+@media (max-width: 768px) { .fase-flecha { display: none; } }
+ 
+/* ================================
+   FOTO SEPARADOR
+================================ */
+.foto-separador {
+  position: relative;
+  height: 380px;
+  overflow: hidden;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.foto-separador img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center bottom;
+}
+.foto-separador-overlay {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 100%);
+  display: flex;
+  align-items: center;
+  padding: 0 60px;
+}
+.foto-separador-texto {
+  max-width: 500px;
+}
+.foto-separador-texto h3 {
+  font-size: 1.8rem;
+  color: white;
+  font-weight: 700;
+  font-family: 'Playfair Display', Georgia, serif;
+  line-height: 1.3;
+  margin-bottom: 12px;
+}
+.foto-separador-texto p {
+  color: rgba(255,255,255,0.8);
+  font-size: 1rem;
+  line-height: 1.7;
+}
+ 
+/* ================================
+   TESTIMONIOS
+================================ */
+.testimonios-section {
+  background: #0F0F0F;
+  padding: 72px 24px;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.testimonios-section h2 {
+  text-align: center;
+  font-size: 1.8rem;
+  color: white;
+  margin-bottom: 8px;
+  font-weight: 700;
+  font-family: 'Playfair Display', Georgia, serif;
+}
+.testimonios-subtitulo {
+  text-align: center;
+  color: rgba(255,255,255,0.5);
+  margin-bottom: 48px;
+  font-size: 1rem;
+}
+.testimonios-grid {
+  display: flex;
+  gap: 24px;
+  flex-wrap: wrap;
+  max-width: 1000px;
+  margin: 0 auto;
+}
+.testimonio-card {
+  flex: 1;
+  min-width: 240px;
+  background: #1a1a1a;
+  border-left: 4px solid #FF4A60;
+  border-radius: 6px;
+  padding: 28px 24px;
+}
+.testimonio-card p {
+  font-style: italic;
+  color: rgba(255,255,255,0.78);
+  line-height: 1.75;
+  margin-bottom: 20px;
+  font-size: 0.95rem;
+}
+.testimonio-card strong {
+  color: white;
+  font-size: 0.95rem;
+  display: block;
+}
+.testimonio-card span {
+  font-size: 0.82rem;
+  color: rgba(255,255,255,0.4);
+  margin-top: 3px;
+  display: block;
+}
+.testimonios-cta {
+  text-align: center;
+  margin-top: 36px;
+}
+.testimonios-cta a {
+  color: #00CDC8;
+  font-weight: 600;
+  font-size: 0.95rem;
+  text-decoration: none;
+}
+.testimonios-cta a:hover { text-decoration: underline; }
+ 
+/* ================================
+   CTA FINAL
+================================ */
+.cta-section {
+  position: relative;
+  padding: 80px 24px;
+  text-align: center;
+  overflow: hidden;
+  margin-left: -15px;
+  margin-right: -15px;
+}
+.cta-bg {
+  position: absolute;
+  inset: 0;
+  background-image: url('{{ site.baseurl }}/assets/images/Encuentro_presencial/grupal_2.jpg');
+  background-size: cover;
+  background-position: center;
+  filter: brightness(0.25);
+}
+.cta-content {
+  position: relative;
+  z-index: 2;
+  max-width: 680px;
+  margin: 0 auto;
+}
+.cta-content h2 {
+  font-size: 2rem;
+  font-weight: 800;
